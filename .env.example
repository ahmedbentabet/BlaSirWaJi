# =============================================================================
# BlaSirWaJi (بلا سير واجي) - Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Get your Gemini / Gemma API key from Google AI Studio:
#    https://aistudio.google.com/app/apikey
# 3. Paste your key below.
# =============================================================================

# Google Gemini / GenAI API Key (Required for live AI routing)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Model override. Default fallback order:
# gemini-3-flash-preview, gemini-flash-latest, gemini-3.5-flash, gemma-4-31b-it
GEMMA_MODEL=gemini-3-flash-preview

# (Optional) Server host and port configuration
PORT=8000
HOST=0.0.0.0